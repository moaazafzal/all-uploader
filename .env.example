# ---------------------------------------------------------------- required
DATABASE_URL=postgres://postgres:postgres@localhost:5432/all_uploader

# 32 bytes, base64. Generate with: openssl rand -base64 32
# Every social token in the database is encrypted with this. Losing it means
# reconnecting every account; leaking it means someone can post as you.
ENCRYPTION_KEY=

# Public base URL of this app. Instagram, Threads, TikTok photo posts and
# Pinterest fetch media FROM this address, so localhost breaks those four.
# In development, run a tunnel and put its URL here:
#   cloudflared tunnel --url http://localhost:3000
APP_URL=http://localhost:3000

# ---------------------------------------------------------------- optional
MAX_UPLOAD_BYTES=2000000000

# Local disk storage. Only works when the web app and the worker share a
# filesystem -- fine on one machine, wrong on any serverless deploy.
STORAGE_DIR=./storage/media

# Long-running worker (npm run worker)
WORKER_CONCURRENCY=4
WORKER_POLL_MS=2000

# ------------------------------------------------------- object storage (S3)
# Set S3_BUCKET to switch off local disk. Required for any deploy where the
# web app and the queue do not share a filesystem.
#
# Cloudflare R2:
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_PUBLIC_URL=https://pub-<hash>.r2.dev      (enable public access on the bucket)
#
# The bucket needs a CORS rule allowing PUT from APP_URL, or browser uploads
# fail:  AllowedOrigins: [APP_URL], AllowedMethods: [PUT], AllowedHeaders: ["*"]
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Public base URL for the bucket. When set, the platforms that fetch media
# themselves read straight from storage instead of through this app.
S3_PUBLIC_URL=

# ------------------------------------------------------------ queue draining
# Required when there is no long-running worker. The scheduled GitHub Action
# calls /api/cron/drain with this as a bearer token. Without it that endpoint
# refuses to run.  Generate with: openssl rand -hex 32
CRON_SECRET=

# -------------------------------------------------- platform credentials
# Leave a block blank to hide that platform's Connect button.
# Bluesky, Mastodon, Telegram and Discord need nothing here -- they are
# connected with per-user credentials in the app itself.

# X  --  https://developer.x.com/en/portal/dashboard
# Callback URL: {APP_URL}/api/oauth/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=

# Meta (Facebook Pages + Instagram)  --  https://developers.facebook.com/apps
# Valid OAuth redirect URIs:
#   {APP_URL}/api/oauth/facebook/callback
#   {APP_URL}/api/oauth/instagram/callback
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0

# Threads  --  separate app credentials from Facebook, same developer console
# Callback: {APP_URL}/api/oauth/threads/callback
THREADS_APP_ID=
THREADS_APP_SECRET=

# TikTok  --  https://developers.tiktok.com
# Callback: {APP_URL}/api/oauth/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# LinkedIn  --  https://www.linkedin.com/developers/apps
# Callback: {APP_URL}/api/oauth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# YouTube  --  https://console.cloud.google.com (enable YouTube Data API v3)
# Callback: {APP_URL}/api/oauth/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Reddit  --  https://www.reddit.com/prefs/apps  (type: web app)
# Callback: {APP_URL}/api/oauth/reddit/callback
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=all-uploader/1.0 by /u/yourusername

# Pinterest  --  https://developers.pinterest.com/apps
# Callback: {APP_URL}/api/oauth/pinterest/callback
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
